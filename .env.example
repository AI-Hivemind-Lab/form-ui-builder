# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after changing it.
# The AI review calls this LiteLLM endpoint from the dev server; the browser never sees the key.
LITELLM_BASE_URL=https://your-litellm-host/v1
LITELLM_API_KEY=sk-...
# The model name as your LiteLLM proxy exposes it (Sonnet 5.5 on Bedrock).
JUDGE_MODEL=
# Optional. Sent as reasoning_effort; if the proxy rejects it the call is retried without it.
JUDGE_REASONING_EFFORT=high

# The assistant (chat) uses JUDGE_MODEL unless you name another here. Unset effort = the model's normal effort.
CHAT_MODEL=
CHAT_REASONING_EFFORT=
# Behind single sign-on (for example Dokploy forward auth in front of Anduin SSO): the header that carries the signed-in user's email.
# When set, every /api request without it is refused. Only expose the app through the sign-in proxy.
AUTH_HEADER=
PORT=3000

# Google sign-in for a hosted deployment (off unless GOOGLE_CLIENT_ID is set). When on, the whole site needs a Google sign-in.
# Create a "Web application" OAuth client in Google Cloud and add your site's address as an authorized JavaScript origin. The client id is public; there is no client secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Who may sign in: whole domains (exact match, no subdomains) and/or single emails, comma-separated. With neither, nobody can sign in.
ALLOWED_DOMAINS=example.com
ALLOWED_EMAILS=
# Signs the session cookie: at least 32 random characters (the server will not start with less). Generate one: openssl rand -hex 32
SESSION_SECRET=
# Hours a sign-in lasts (default 12).
SESSION_HOURS=12
